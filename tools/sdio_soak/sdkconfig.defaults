# tools/sdio_soak — bare-IDF soak test of the ESP32-P4 ↔ ESP32-C6 SDIO link (docs/SOAK_TEST.md).
# Transport block identical to boards/p4_player/sdkconfig.board — keep them in sync.

# ── Chip revision: Guition panel ships ESP32-P4 v1.3 ──
# docs/C6_UPDATE.md, "Host configuration the C6 link depends on".
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y

# ── ESP-Hosted host, C6 on SDIO slot 1, 4-bit, 40 MHz, reset GPIO54 (3.x "active low") ──
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_HOST_TRANSPORT_BUS_SDIO=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_HOST_SDIO_BUS_WIDTH_4=y
CONFIG_ESP_HOSTED_HOST_SDIO_CLK_KHZ=40000
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_HOST_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_HOST_RESET_GPIO=54
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
CONFIG_ESP_HOSTED_HOST_SDIO_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ITWT=n
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y

# ── Flash / partitions: identical to the player (NVS with Wi-Fi creds at the same offset) ──
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y

# ── PSRAM (ring buffer + transport pools live there) ──
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ── TLS. The player's 4 KB budget (docs/CONCEPT.md, "Network") does NOT survive a real station:
#    icecast.radiofrance.fr ignores max_fragment_length and sends 16 KB records → with
#    IN_CONTENT_LEN=4096 every read dies with -0x7200 after ~1 s (bench). The
#    soak run therefore uses the mbedTLS default 16 KB input buffer (+12 KB DMA-SRAM per
#    TLS session); OUT stays 4 KB (we only send headers). This is a design input for the
#    radio stage, not a soak-tool detail. ──
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_SSL_MAX_FRAGMENT_LEN=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y
CONFIG_ESP_COREDUMP_CHECKSUM_CRC32=y
