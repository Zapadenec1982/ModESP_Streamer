# === Build ===
/build/
tests/host/build/
*.elf
*.map

# === Generated (regenerated on every build) ===
/generated/
data/ui.json
data/board.json
data/bindings.json
# Runtime device registry — written by the device to /data/devices.json at runtime, NEVER a
# build input. Must not be committed or left in data/ during a build, or a stray/test file gets
# baked into data.bin and flashed, clobbering the device's real subscriptions.
data/devices.json
# Per-driver menuconfig toggles, generated from drivers/*/manifest.json
components/modesp_hal/Kconfig
# Board choice, generated from boards/*/board.json
main/Kconfig.boards

# === ESP-IDF managed dependencies ===
/managed_components/
# dependencies.lock IS committed (also under tools/c6_updater and tools/sdio_soak): it pins the
# resolved component set so a fresh clone builds the bench-verified firmware.

# === SDK config (keep sdkconfig.defaults, ignore generated) ===
sdkconfig
sdkconfig.old

# === Python ===
__pycache__/
*.pyc
.pytest_cache/

# === Claude Code local settings ===
.claude/

# === OS ===
.DS_Store
Thumbs.db
desktop.ini

# === Editor ===
*.swp
*.swo
*~
*.orig
*.bak

