menu "ModESP Configuration"
    # Board choice — generated from boards/*/board.json by tools/generate_ui.py
    # (main/Kconfig.boards, DO NOT EDIT). Adding boards/my_board/board.json is
    # enough for the board to appear here — no framework edits.
    rsource "Kconfig.boards"

    choice MODESP_CLOUD_BACKEND
        prompt "Cloud backend"
        default MODESP_CLOUD_MQTT if MODESP_NET_ENABLE
        default MODESP_CLOUD_NONE
        help
            Select the cloud communication backend.
            None: offline product — no cloud service is compiled or registered.
            MQTT: self-hosted Mosquitto broker (Home Assistant discovery).

        config MODESP_CLOUD_NONE
            bool "None (offline product)"

        config MODESP_CLOUD_MQTT
            bool "Mosquitto (self-hosted MQTT)"
            depends on MODESP_NET_ENABLE
    endchoice

    config MODESP_MQTT_REMOTE_ADMIN
        bool "The broker may flash the firmware and rewrite the MQTT settings"
        depends on MODESP_CLOUD_MQTT
        default y
        help
            The MQTT commands _ota (flash an image from the URL in the payload),
            _set_mqtt_creds and _set_tenant, for a fleet run from its broker.
            Anyone who can publish to the broker can use them, with no HTTP
            login. Home Assistant needs none of them; a device on a home broker
            turns this off, and the three are then unknown keys.
endmenu

# Per-driver enable/disable toggles live in components/modesp_hal/Kconfig,
# auto-generated by tools/generate_ui.py from drivers/*/manifest.json and
# auto-discovered by ESP-IDF as a component Kconfig (menu "ModESP Drivers").
# The network master switch lives in components/modesp_net/Kconfig.
